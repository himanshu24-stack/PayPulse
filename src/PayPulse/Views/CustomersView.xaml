<UserControl x:Class="PayPulse.Views.CustomersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:PayPulse.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:CustomersViewModel}">
    <Grid Margin="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="380"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left List Panel -->
        <Border Grid.Column="0" Background="White" CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1" Margin="0,0,16,0" Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Search and Add Customer Button -->
                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <TextBlock Text="Customer Directory" FontSize="18" FontWeight="Bold" Foreground="#0F172A"/>
                    <Button Command="{Binding OpenAddFormCommand}" 
                            HorizontalAlignment="Right" 
                            Content="+ Add Customer" 
                            Background="#0D9488" 
                            Foreground="White" 
                            FontWeight="SemiBold" 
                            Padding="12,6" 
                            BorderThickness="0" 
                            Cursor="Hand"/>
                </Grid>

                <!-- Search Input -->
                <TextBox Grid.Row="1" 
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                         Padding="10,8" 
                         FontSize="13" 
                         Margin="0,0,0,12" 
                         BorderBrush="#CBD5E1"/>

                <!-- Customers ListBox -->
                <ListBox Grid.Row="2" 
                         ItemsSource="{Binding Customers}" 
                         SelectedItem="{Binding SelectedCustomer, Mode=TwoWay}"
                         BorderThickness="0"
                         Background="Transparent">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="12" Margin="0,0,0,6" Background="#F8FAFC" CornerRadius="6" BorderBrush="#E2E8F0" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="14" Foreground="#0F172A"/>
                                    <TextBlock Text="{Binding Email}" FontSize="12" Foreground="#64748B" Margin="0,2,0,0"/>
                                    <TextBlock Text="{Binding Phone}" FontSize="12" Foreground="#0D9488" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <!-- Right Detail / Edit Panel -->
        <Border Grid.Column="1" Background="White" CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1" Padding="24">
            <!-- Edit/Add Form -->
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- Read-Only Details View -->
                    <StackPanel Visibility="{Binding IsEditing, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                        <Grid Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="{Binding SelectedCustomer.Name, FallbackValue='Select a Customer'}" FontSize="22" FontWeight="Bold" Foreground="#0F172A"/>
                                <TextBlock Text="{Binding SelectedCustomer.ContactPerson, StringFormat='Contact Person: {0}', FallbackValue='-'}" FontSize="13" Foreground="#64748B" Margin="0,4,0,0"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Command="{Binding OpenEditFormCommand}" Content="✏️ Edit" Padding="14,6" Margin="0,0,8,0" Background="#F1F5F9" Foreground="#334155" BorderBrush="#CBD5E1" Cursor="Hand"/>
                                <Button Command="{Binding DeleteCustomerCommand}" Content="🗑️ Delete" Padding="14,6" Background="#FEE2E2" Foreground="#991B1B" BorderThickness="0" Cursor="Hand"/>
                            </StackPanel>
                        </Grid>

                        <Separator Background="#E2E8F0" Margin="0,0,0,16"/>

                        <!-- Customer Info Cards -->
                        <UniformGrid Columns="2" Margin="0,0,0,20">
                            <Border Background="#F8FAFC" Padding="14" CornerRadius="6" Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="COMMUNICATION" FontSize="11" FontWeight="Bold" Foreground="#64748B"/>
                                    <TextBlock Text="{Binding SelectedCustomer.Email, StringFormat='Email: {0}'}" FontSize="13" Margin="0,6,0,0"/>
                                    <TextBlock Text="{Binding SelectedCustomer.Phone, StringFormat='Phone: {0}'}" FontSize="13" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Background="#F8FAFC" Padding="14" CornerRadius="6" Margin="8,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="BILLING ADDRESS &amp; NOTES" FontSize="11" FontWeight="Bold" Foreground="#64748B"/>
                                    <TextBlock Text="{Binding SelectedCustomer.BillingAddress, FallbackValue='No address specified'}" FontSize="13" Margin="0,6,0,0" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding SelectedCustomer.Notes, FallbackValue='No notes'}" FontSize="12" Foreground="#64748B" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <TextBlock Text="Customer Invoices &amp; Ledger History" FontSize="16" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,12"/>
                        <DataGrid ItemsSource="{Binding CustomerInvoices}" 
                                  AutoGenerateColumns="False" 
                                  IsReadOnly="True" 
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  BorderBrush="#E2E8F0"
                                  BorderThickness="1"
                                  HeadersVisibility="Column"
                                  RowHeight="36">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Invoice #" Binding="{Binding InvoiceNumber}" Width="130" FontWeight="SemiBold"/>
                                <DataGridTextColumn Header="Issue Date" Binding="{Binding IssueDate, StringFormat=dd-MMM-yyyy}" Width="120"/>
                                <DataGridTextColumn Header="Due Date" Binding="{Binding DueDate, StringFormat=dd-MMM-yyyy}" Width="120"/>
                                <DataGridTextColumn Header="Total Amount" Binding="{Binding TotalAmount, Converter={StaticResource CurrencyConverter}}" Width="140"/>
                                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>

                    <!-- Add / Edit Form -->
                    <StackPanel Visibility="{Binding IsEditing, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="Customer Form" FontSize="20" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,16"/>

                        <TextBlock Text="Customer / Business Name *" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding FormName, UpdateSourceTrigger=PropertyChanged}" Padding="8" Margin="0,0,0,12"/>

                        <TextBlock Text="Contact Person Name (Optional)" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding FormContact, UpdateSourceTrigger=PropertyChanged}" Padding="8" Margin="0,0,0,12"/>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="Email Address *" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding FormEmail, UpdateSourceTrigger=PropertyChanged}" Padding="8"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                <TextBlock Text="Phone Number *" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding FormPhone, UpdateSourceTrigger=PropertyChanged}" Padding="8"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Billing Address (Optional)" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding FormAddress, UpdateSourceTrigger=PropertyChanged}" Padding="8" Height="60" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,0,0,12"/>

                        <TextBlock Text="Notes (Optional)" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding FormNotes, UpdateSourceTrigger=PropertyChanged}" Padding="8" Height="50" TextWrapping="Wrap" Margin="0,0,0,16"/>

                        <!-- Error Banner -->
                        <TextBlock Text="{Binding ErrorMessage}" Foreground="#E11D48" FontWeight="SemiBold" Margin="0,0,0,12"/>

                        <StackPanel Orientation="Horizontal">
                            <Button Command="{Binding SaveCustomerCommand}" Content="Save Customer" Background="#0D9488" Foreground="White" FontWeight="Bold" Padding="20,10" BorderThickness="0" Cursor="Hand" Margin="0,0,12,0"/>
                            <Button Command="{Binding CancelFormCommand}" Content="Cancel" Background="#F1F5F9" Foreground="#475569" Padding="16,10" BorderThickness="1" BorderBrush="#CBD5E1" Cursor="Hand"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
