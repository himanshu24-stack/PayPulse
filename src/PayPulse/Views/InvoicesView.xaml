<UserControl x:Class="PayPulse.Views.InvoicesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:PayPulse.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:InvoicesViewModel}">
    <Grid Margin="24">
        <!-- Main Invoice Listing -->
        <Grid Visibility="{Binding IsCreatingInvoice, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Top Action Header -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Invoices &amp; Billing Records" FontSize="20" FontWeight="Bold" Foreground="#0F172A"/>
                    <TextBlock Text="Create, filter, track and reconcile invoices" FontSize="13" Foreground="#64748B"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Command="{Binding OpenCreateInvoiceCommand}" 
                            Content="⚡ Create New Invoice" 
                            Background="#0D9488" 
                            Foreground="White" 
                            FontWeight="Bold" 
                            Padding="16,8" 
                            BorderThickness="0" 
                            Cursor="Hand"/>
                </StackPanel>
            </Grid>

            <!-- Filter Bar -->
            <Border Grid.Row="1" Background="White" CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1" Padding="12" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Search Input -->
                    <TextBox Grid.Column="0" 
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                             Padding="8" 
                             Margin="0,0,12,0" 
                             BorderBrush="#CBD5E1"/>

                    <!-- Status Filter Combo -->
                    <ComboBox Grid.Column="1" 
                              SelectedValue="{Binding SelectedStatusFilter, Mode=TwoWay}"
                              SelectedValuePath="Content"
                              Padding="8,6" 
                              Margin="0,0,12,0">
                        <ComboBoxItem Content="All" IsSelected="True"/>
                        <ComboBoxItem Content="Unpaid"/>
                        <ComboBoxItem Content="PartiallyPaid"/>
                        <ComboBoxItem Content="Paid"/>
                        <ComboBoxItem Content="Overdue"/>
                        <ComboBoxItem Content="Draft"/>
                    </ComboBox>

                    <Button Grid.Column="2" Command="{Binding LoadInvoicesCommand}" Content="Apply Filters" Padding="12,6" Background="#F1F5F9" Foreground="#334155" BorderBrush="#CBD5E1" Cursor="Hand"/>
                </Grid>
            </Border>

            <!-- Invoices Table -->
            <Border Grid.Row="2" Background="White" CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1" Padding="16">
                <DataGrid ItemsSource="{Binding Invoices}" 
                          SelectedItem="{Binding SelectedInvoice, Mode=TwoWay}"
                          AutoGenerateColumns="False" 
                          IsReadOnly="True" 
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          Background="Transparent"
                          BorderBrush="#E2E8F0"
                          BorderThickness="1"
                          HeadersVisibility="Column"
                          RowHeight="40"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#F1F5F9">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Invoice #" Binding="{Binding InvoiceNumber}" Width="130" FontWeight="SemiBold"/>
                        <DataGridTextColumn Header="Customer" Binding="{Binding Customer.Name}" Width="*"/>
                        <DataGridTextColumn Header="Issue Date" Binding="{Binding IssueDate, StringFormat=dd-MMM-yyyy}" Width="120"/>
                        <DataGridTextColumn Header="Due Date" Binding="{Binding DueDate, StringFormat=dd-MMM-yyyy}" Width="120"/>
                        <DataGridTextColumn Header="Total Amount" Binding="{Binding TotalAmount, Converter={StaticResource CurrencyConverter}}" Width="140" FontWeight="SemiBold"/>
                        <DataGridTemplateColumn Header="Status" Width="130">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="{Binding Status, Converter={StaticResource StatusBadgeBgConverter}}" 
                                            CornerRadius="4" Padding="8,3" HorizontalAlignment="Left">
                                        <TextBlock Text="{Binding Status}" 
                                                   FontSize="11" 
                                                   FontWeight="Bold" 
                                                   Foreground="{Binding Status, Converter={StaticResource StatusBadgeFgConverter}}"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Action" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding DataContext.DeleteInvoiceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                            Content="🗑️ Delete" 
                                            FontSize="11" 
                                            Padding="6,2" 
                                            Background="#FEE2E2" 
                                            Foreground="#991B1B" 
                                            BorderThickness="0" 
                                            Cursor="Hand"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>

        <!-- Create Invoice Panel -->
        <Border Visibility="{Binding IsCreatingInvoice, Converter={StaticResource BooleanToVisibilityConverter}}" 
                Background="White" CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1" Padding="24">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="Create New Invoice" FontSize="20" FontWeight="Bold" Foreground="#0F172A"/>
                            <TextBlock Text="Add customer billing details, line items, taxes and discounts" FontSize="13" Foreground="#64748B"/>
                        </StackPanel>
                        <Button Command="{Binding CancelCreateInvoiceCommand}" Content="✕ Close" HorizontalAlignment="Right" Padding="12,6" Background="#F1F5F9" Foreground="#64748B" BorderThickness="0" Cursor="Hand"/>
                    </Grid>

                    <Separator Background="#E2E8F0"/>

                    <!-- Customer & Invoice Numbers -->
                    <UniformGrid Columns="3">
                        <StackPanel Margin="0,0,12,0">
                            <TextBlock Text="Select Customer *" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <ComboBox ItemsSource="{Binding AvailableCustomers}" 
                                      SelectedItem="{Binding FormSelectedCustomer, Mode=TwoWay}" 
                                      DisplayMemberPath="Name" 
                                      Padding="8"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,12,0">
                            <TextBlock Text="Invoice Number *" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding FormInvoiceNumber, UpdateSourceTrigger=PropertyChanged}" Padding="8"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Due Date *" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <DatePicker SelectedDate="{Binding FormDueDate, Mode=TwoWay}" Padding="8"/>
                        </StackPanel>
                    </UniformGrid>

                    <!-- Line Items Section -->
                    <Border Background="#F8FAFC" CornerRadius="6" Padding="16" BorderBrush="#E2E8F0" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Line Items" FontSize="15" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,8"/>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="120"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{Binding FormItemDesc, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" Padding="8"/>
                                <TextBox Grid.Column="1" Text="{Binding FormItemQty, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" Padding="8"/>
                                <TextBox Grid.Column="2" Text="{Binding FormItemUnitPrice, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" Padding="8"/>
                                <Button Grid.Column="3" Command="{Binding AddLineItemCommand}" Content="+ Add Item" Background="#0D9488" Foreground="White" FontWeight="Bold" Padding="8" BorderThickness="0" Cursor="Hand"/>
                            </Grid>

                            <DataGrid ItemsSource="{Binding FormItems}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column" RowHeight="32" Background="White" BorderThickness="1" BorderBrush="#E2E8F0">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*"/>
                                    <DataGridTextColumn Header="Quantity" Binding="{Binding Quantity}" Width="100"/>
                                    <DataGridTextColumn Header="Unit Price" Binding="{Binding UnitPrice, Converter={StaticResource CurrencyConverter}}" Width="140"/>
                                    <DataGridTextColumn Header="Amount" Binding="{Binding Amount, Converter={StaticResource CurrencyConverter}}" Width="140"/>
                                    <DataGridTemplateColumn Header="Action" Width="80">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Command="{Binding DataContext.RemoveLineItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                        CommandParameter="{Binding}" Content="✕" Foreground="#B91C1C" Background="Transparent" BorderThickness="0" Cursor="Hand"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>

                    <!-- Summary & Taxes Calculation -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="340"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,24,0">
                            <TextBlock Text="Notes / Description" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding FormDescription, UpdateSourceTrigger=PropertyChanged}" Height="80" TextWrapping="Wrap" AcceptsReturn="True" Padding="8"/>
                        </StackPanel>

                        <Border Grid.Column="1" Background="#F1F5F9" CornerRadius="6" Padding="16">
                            <StackPanel>
                                <Grid Margin="0,0,0,6">
                                    <TextBlock Text="Subtotal:" FontSize="13" Foreground="#475569"/>
                                    <TextBlock Text="{Binding CalculatedSubtotal, Converter={StaticResource CurrencyConverter}}" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                                </Grid>
                                <Grid Margin="0,0,0,6">
                                    <TextBlock Text="Discount (₹):" FontSize="13" Foreground="#475569" VerticalAlignment="Center"/>
                                    <TextBox Text="{Binding FormDiscount, UpdateSourceTrigger=PropertyChanged}" Width="100" HorizontalAlignment="Right" Padding="4"/>
                                </Grid>
                                <Grid Margin="0,0,0,6">
                                    <TextBlock Text="GST Rate (%):" FontSize="13" Foreground="#475569" VerticalAlignment="Center"/>
                                    <TextBox Text="{Binding FormTaxRate, UpdateSourceTrigger=PropertyChanged}" Width="100" HorizontalAlignment="Right" Padding="4"/>
                                </Grid>
                                <Grid Margin="0,0,0,8">
                                    <TextBlock Text="Tax Amount:" FontSize="13" Foreground="#475569"/>
                                    <TextBlock Text="{Binding CalculatedTax, Converter={StaticResource CurrencyConverter}}" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                                </Grid>
                                <Separator Background="#CBD5E1" Margin="0,0,0,8"/>
                                <Grid>
                                    <TextBlock Text="Total Payable:" FontSize="15" FontWeight="Bold" Foreground="#0F172A"/>
                                    <TextBlock Text="{Binding CalculatedTotal, Converter={StaticResource CurrencyConverter}}" HorizontalAlignment="Right" FontSize="18" FontWeight="Bold" Foreground="#0D9488"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Error Text -->
                    <TextBlock Text="{Binding FormErrorMessage}" Foreground="#E11D48" FontWeight="SemiBold"/>

                    <!-- Action Buttons -->
                    <StackPanel Orientation="Horizontal">
                        <Button Command="{Binding SaveInvoiceCommand}" Content="Save &amp; Generate Invoice" Background="#0D9488" Foreground="White" FontWeight="Bold" Padding="20,10" BorderThickness="0" Cursor="Hand" Margin="0,0,12,0"/>
                        <Button Command="{Binding CancelCreateInvoiceCommand}" Content="Cancel" Background="#F1F5F9" Foreground="#475569" Padding="16,10" BorderThickness="1" BorderBrush="#CBD5E1" Cursor="Hand"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
