<UserControl x:Class="PayPulse.Views.RiskAnalysisView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:PayPulse.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:RiskAnalysisViewModel}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="Payment Risk &amp; Delinquency Scoring" FontSize="20" FontWeight="Bold" Foreground="#0F172A"/>
                <TextBlock Text="Deterministic rule-based risk evaluation based on aging, exposure, and payment history" FontSize="13" Foreground="#64748B"/>
            </StackPanel>
            <Button Command="{Binding LoadRiskAnalysisCommand}" Content="🔄 Re-evaluate Risk" HorizontalAlignment="Right" Padding="14,6" Background="#0D9488" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
        </Grid>

        <!-- KPI Cards -->
        <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,16">
            <Border Background="White" CornerRadius="8" Padding="14" Margin="0,0,12,0" BorderBrush="#FECACA" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="HIGH RISK INVOICES" FontSize="11" FontWeight="Bold" Foreground="#DC2626"/>
                    <TextBlock Text="{Binding HighRiskCount}" FontSize="22" FontWeight="Bold" Foreground="#DC2626" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
            <Border Background="White" CornerRadius="8" Padding="14" Margin="0,0,12,0" BorderBrush="#FDE68A" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="MEDIUM RISK" FontSize="11" FontWeight="Bold" Foreground="#D97706"/>
                    <TextBlock Text="{Binding MediumRiskCount}" FontSize="22" FontWeight="Bold" Foreground="#D97706" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
            <Border Background="White" CornerRadius="8" Padding="14" Margin="0,0,12,0" BorderBrush="#BBF7D0" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="LOW RISK" FontSize="11" FontWeight="Bold" Foreground="#16A34A"/>
                    <TextBlock Text="{Binding LowRiskCount}" FontSize="22" FontWeight="Bold" Foreground="#16A34A" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
            <Border Background="White" CornerRadius="8" Padding="14" BorderBrush="#E2E8F0" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="HIGH-RISK EXPOSURE" FontSize="11" FontWeight="Bold" Foreground="#475569"/>
                    <TextBlock Text="{Binding HighRiskExposure, Converter={StaticResource CurrencyConverter}}" FontSize="20" FontWeight="Bold" Foreground="#DC2626" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- Content Area: Left Table, Right Action/Factor Card -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="420"/>
            </Grid.ColumnDefinitions>

            <!-- Risk Table -->
            <Border Grid.Column="0" Background="White" CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1" Margin="0,0,16,0" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                        <TextBlock Text="Filter by Level: " VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,8,0"/>
                        <ComboBox SelectedValue="{Binding FilterRiskLevel, Mode=TwoWay}" SelectedValuePath="Content" Width="140" Padding="6">
                            <ComboBoxItem Content="All" IsSelected="True"/>
                            <ComboBoxItem Content="High"/>
                            <ComboBoxItem Content="Medium"/>
                            <ComboBoxItem Content="Low"/>
                        </ComboBox>
                    </StackPanel>

                    <DataGrid Grid.Row="1" 
                              ItemsSource="{Binding RiskResults}" 
                              SelectedItem="{Binding SelectedRiskItem, Mode=TwoWay}"
                              AutoGenerateColumns="False" 
                              IsReadOnly="True" 
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              BorderBrush="#E2E8F0"
                              BorderThickness="1"
                              HeadersVisibility="Column"
                              RowHeight="38">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Invoice #" Binding="{Binding InvoiceNumber}" Width="120" FontWeight="SemiBold"/>
                            <DataGridTextColumn Header="Client" Binding="{Binding CustomerName}" Width="*"/>
                            <DataGridTextColumn Header="Balance" Binding="{Binding OutstandingAmount, Converter={StaticResource CurrencyConverter}}" Width="130"/>
                            <DataGridTextColumn Header="Days Overdue" Binding="{Binding DaysOverdue}" Width="100"/>
                            <DataGridTextColumn Header="Score" Binding="{Binding RiskScore, StringFormat={}{0}/100}" Width="80"/>
                            <DataGridTemplateColumn Header="Risk Level" Width="110">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="{Binding RiskLevel, Converter={StaticResource RiskBadgeBgConverter}}" 
                                                CornerRadius="4" Padding="8,3" HorizontalAlignment="Left">
                                            <TextBlock Text="{Binding RiskLevel}" 
                                                       FontSize="11" 
                                                       FontWeight="Bold" 
                                                       Foreground="{Binding RiskLevel, Converter={StaticResource RiskBadgeFgConverter}}"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- Right Detail / Recommendations & Reminders -->
            <Border Grid.Column="1" Background="White" CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1" Padding="20">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="{Binding SelectedRiskItem.InvoiceNumber, FallbackValue='Select an invoice'}" FontSize="18" FontWeight="Bold" Foreground="#0F172A"/>
                                <TextBlock Text="{Binding SelectedRiskItem.CustomerName, FallbackValue='-'}" FontSize="13" Foreground="#64748B"/>
                            </StackPanel>
                            <Border Background="{Binding SelectedRiskItem.RiskLevel, Converter={StaticResource RiskBadgeBgConverter}}" 
                                    CornerRadius="4" Padding="10,4" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBlock Text="{Binding SelectedRiskItem.RiskLevel, StringFormat='{}RISK: {0}'}" 
                                           FontWeight="Bold" 
                                           Foreground="{Binding SelectedRiskItem.RiskLevel, Converter={StaticResource RiskBadgeFgConverter}}"/>
                            </Border>
                        </Grid>

                        <Separator Background="#E2E8F0"/>

                        <!-- Contributing Factors -->
                        <Border Background="#F8FAFC" CornerRadius="6" Padding="14" BorderBrush="#E2E8F0" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="CONTRIBUTING RISK FACTORS" FontSize="11" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,8"/>
                                <ItemsControl ItemsSource="{Binding SelectedRiskItem.Factors}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                <TextBlock Text="• " FontWeight="Bold" Foreground="#E11D48"/>
                                                <TextBlock Text="{Binding}" FontSize="12" Foreground="#334155" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- Recommended Action Box -->
                        <Border Background="#FEF3C7" CornerRadius="6" Padding="14" BorderBrush="#FDE68A" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="RECOMMENDED ACTION" FontSize="11" FontWeight="Bold" Foreground="#92400E" Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding SelectedRiskItem.RecommendedAction}" FontSize="12" Foreground="#78350F" TextWrapping="Wrap" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>

                        <!-- Action Buttons -->
                        <UniformGrid Columns="2">
                            <Button Command="{Binding CopyReminderMessageCommand}" Content="📋 Copy Notice" Padding="10,8" Margin="0,0,6,0" Background="#F1F5F9" Foreground="#334155" BorderBrush="#CBD5E1" Cursor="Hand" FontWeight="SemiBold"/>
                            <Button Command="{Binding LogFollowUpCompletedCommand}" Content="✓ Log Follow-up" Padding="10,8" Margin="6,0,0,0" Background="#0D9488" Foreground="White" BorderThickness="0" Cursor="Hand" FontWeight="SemiBold"/>
                        </UniformGrid>

                        <!-- Reminder History -->
                        <TextBlock Text="Follow-up Contact History" FontSize="14" FontWeight="Bold" Foreground="#0F172A"/>
                        <DataGrid ItemsSource="{Binding ReminderHistory}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column" RowHeight="30" BorderThickness="1" BorderBrush="#E2E8F0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Date" Binding="{Binding ReminderDate, StringFormat=dd-MMM}" Width="70"/>
                                <DataGridTextColumn Header="Type" Binding="{Binding ReminderType}" Width="100"/>
                                <DataGridTextColumn Header="Notes" Binding="{Binding Notes}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
